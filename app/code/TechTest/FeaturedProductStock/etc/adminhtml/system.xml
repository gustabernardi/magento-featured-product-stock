<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="featured_product_stock"
                 translate="label"
                 type="text"
                 sortOrder="310"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>Featured Product Stock</label>
            <tab>catalog</tab>
            <resource>TechTest_FeaturedProductStock::config</resource>
            <group id="general"
                   translate="label"
                   type="text"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">
                <label>General Settings</label>
                <field id="enabled"
                       translate="label"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="product_sku"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Featured Product SKU</label>
                    <comment>Use the product SKU that should be displayed on the homepage.</comment>
                    <backend_model>TechTest\FeaturedProductStock\Model\Config\Backend\ProductSku</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="poll_interval"
                       translate="label comment"
                       type="text"
                       sortOrder="30"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Stock Refresh Interval (ms)</label>
                    <comment>Minimum accepted value is 1000 milliseconds.</comment>
                    <backend_model>TechTest\FeaturedProductStock\Model\Config\Backend\PollInterval</backend_model>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
